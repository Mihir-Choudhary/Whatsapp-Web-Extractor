# NEVER commit real evidence, decrypted data, or credentials
evidence/
analysis/
notes/
STATE.md
CONTINUE.md
tools/reconnect/node_modules/
reconnect_creds.json
noise_keys.json
*.pkl
__pycache__/
*.pyc

# Runtime secrets/outputs — un-anchored so they match at the repo root TOO, not just
# under tools/reconnect/. The frozen .exe writes these into the CURRENT directory
# (creds_in.json = Noise private key; companion_enc_static.txt = the at-rest master key),
# so a `git add .` from a repo clone must never be able to stage them.
creds_in.json
companion_enc_static.txt
signal_state.json
appstate_keys.json
# Un-anchored AND wildcarded: the overlay is key material, and archived/renamed copies of it
# (signal_runtime.json.dev43, .bak.dev43, .2026-10-01 ...) must not slip past this the way an
# exact-name list lets them.
signal_runtime.json*
signal_state.json*
appstate_keys.json*
creds_in.json*
anchors.json
notifs.json
history_*.json
# Any file holding RECOVERED MESSAGES is evidence, whatever it is called. The list above names
# outputs one by one, so each new diagnostic that writes recovered data needs a new line and the
# next one gets forgotten -- onehistory_recovered.json was committable for exactly that reason.
# Match on the naming instead of the filename.
*recovered*.json
*_recovered.json
onehistory_recovered.json

# Akhil Dara's WAInsight is a SEPARATE MIT repo — do NOT bundle it
WAInsight/
wainsight_case/
storage_export/
wa_decrypted/

# Chain-of-custody case databases (--audit) and common output dirs: these hold real evidence
# (decrypted messages, contacts, evidence hashes, key fingerprints) and must never be committed.
wawf_audit.db
wawf_audit.db-wal
wawf_audit.db-shm
*.audit.db
db/
out/

# PyInstaller build artifacts (the recipe wawf.spec IS committed; the outputs are not)
build/
dist/
*.log

# reconnect runtime logs/outputs (secrets themselves are covered un-anchored above)
tools/reconnect/baileys.log
wa_sqlite/

# Media recovery working files. media_retry_in.json carries mediaKeys (secrets) and chat jids (PII);
# media_retry_out.json carries freshly minted CDN capability URLs. Un-anchored, like the others.
media_retry_in.json
media_retry_out.json

# the tool's OWN linked-device credentials (pair.js) — key material
wawf_device/
